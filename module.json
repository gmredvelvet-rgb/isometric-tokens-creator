{
  "id": "isometric-tokens-creator",
  "title": "Isometric Token Creator",
  "description": "Visual editor for composing isometric tokens (base + character + shadow) and exporting them as transparent PNGs aligned to the isometric-perspective projection. Works with D&D 5e, Pathfinder 2e, and system-agnostic worlds. Early Access.",
  "version": "1.0.0",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "authors": [
    {
      "name": "GMRedVelvet"
    }
  ],
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/itc-variables.css",
    "styles/itc-app.css",
    "styles/itc-panels.css",
    "styles/itc-widgets.css",
    "styles/itc-viewport.css",
    "styles/itc-license.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "es",
      "name": "Español",
      "path": "lang/es.json"
    }
  ],
  "relationships": {
    "recommends": [
      {
        "id": "isometric-perspective",
        "type": "module",
        "reason": "Applies the isometric projection to the canvas. ITC reads that projection to align exported tokens."
      }
    ]
  },
  "socket": false,
  "url": "https://github.com/gmredvelvet-rgb/isometric-tokens-creator",
  "manifest": "https://github.com/gmredvelvet-rgb/isometric-tokens-creator/releases/latest/download/module.json",
  "download": "https://github.com/gmredvelvet-rgb/isometric-tokens-creator/releases/latest/download/module.zip"
}
